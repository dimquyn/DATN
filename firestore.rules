rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Nhân viên CSKH đăng nhập qua mobile app (Firebase Auth). Không phân
    // quyền theo vai trò — mọi tài khoản đã đăng nhập đều được xem là nhân
    // viên hợp lệ (đủ cho phạm vi đồ án hiện tại).
    function isStaff() {
      return request.auth != null;
    }

    // Khách gửi khiếu nại từ website (KHÔNG đăng nhập) chỉ được tạo ticket
    // mới đúng ở trạng thái ban đầu, với đúng bộ field mà form gửi lên —
    // không được tự gán người xử lý, kết quả AI, hay chèn thêm field lạ.
    // Giới hạn độ dài/định dạng khớp với website/src/utils/validation.ts để
    // gọi thẳng Firestore SDK (bỏ qua form) cũng không tạo được ticket sai
    // định dạng: họ tên 1-100 ký tự, SĐT di động Việt Nam 10 số, email
    // đúng định dạng tối đa 100 ký tự, nội dung 20-1000 ký tự (sau trim).
    // Mã ticket phải đúng bằng giá trị bộ đếm SAU khi tăng trong cùng
    // transaction (TK01, TK02, ..., TK10, TK100) — tức là mỗi ticket mới bắt
    // buộc tăng bộ đếm đúng 1 lần và không thể tự đặt mã trùng/giả mạo.
    function isNextTicketCode(code) {
      let counterPath = /databases/$(database)/documents/counters/tickets;
      let countBefore = exists(counterPath) ? get(counterPath).data.count : 0;
      let countAfter = getAfter(counterPath).data.count;
      return countAfter == countBefore + 1
        && code == (countAfter < 10 ? 'TK0' + string(countAfter) : 'TK' + string(countAfter));
    }

    function isValidNewTicket() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'code', 'customerName', 'phone', 'email', 'content',
          'channel', 'status', 'assignedTo', 'aiResultId', 'createdAt', 'updatedAt'
        ])
        && data.status == 'pending'
        && data.assignedTo == null
        && data.aiResultId == null
        && data.code is string && isNextTicketCode(data.code)
        && data.customerName is string && data.customerName.trim().size() > 0 && data.customerName.size() <= 100
        && data.phone is string && data.phone.matches('0[35789][0-9]{8}')
        && data.email is string && data.email.size() <= 100 && data.email.matches('[^\\s@]+@[^\\s@]+[.][^\\s@]+')
        && data.content is string && data.content.trim().size() >= 20 && data.content.size() <= 1000
        && data.channel in ['Website', 'Facebook', 'Zalo', 'Email']
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // Nhân viên chỉ được đổi trạng thái/người xử lý/phản hồi cuối cùng theo
    // đúng 1 trong 3 bước chuyển hợp lệ (khớp luồng ở Ticket Detail) —
    // không được sửa nội dung gốc của khách hàng hay giả mạo kết quả AI
    // (aiResultId, priority, lastAIError chỉ do Cloud Functions ghi qua
    // Admin SDK, vốn không đi qua rules này).
    function isValidStaffTicketUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let changedKeys = after.diff(before).affectedKeys();

      return isStaff()
        && after.updatedAt == request.time
        && (
          // "Nhận xử lý": ai_analyzed -> in_progress, tự gán cho chính mình.
          // Cũng cho phép từ "pending" nếu AI đã thất bại (có lastAIError) —
          // ticket bị AI phân tích lỗi mãi mãi kẹt ở "pending" nên nhân viên
          // cần tự nhận xử lý thủ công thay vì chờ AI không bao giờ xong.
          // Bắt buộc assignedTo cũ phải null: vừa validate dữ liệu vừa chặn
          // race condition khi 2 nhân viên cùng bấm "Nhận xử lý" 1 lúc — ai
          // commit trước sẽ khiến request của người còn lại bị từ chối vì
          // lúc đó resource.data.assignedTo không còn null nữa.
          (
            changedKeys.hasOnly(['status', 'assignedTo', 'assignedToName', 'updatedAt'])
            && (before.status == 'ai_analyzed' || (before.status == 'pending' && 'lastAIError' in before))
            && before.assignedTo == null
            && after.status == 'in_progress'
            && after.assignedTo == request.auth.uid
            && (!('assignedToName' in after) || after.assignedToName is string)
          )
          // "Xác nhận đã phản hồi": in_progress -> responded, kèm finalReply.
          // Hình thức liên hệ hiển thị cho nhân viên lấy thẳng từ channel
          // của ticket (khiếu nại tới từ đâu thì phản hồi qua đó), không
          // còn là field riêng để nhân viên tự chọn.
          // Chỉ chính nhân viên đã "Nhận xử lý" (assignedTo) mới được phản
          // hồi — nhân viên khác không thể phản hồi thay.
          || (
            changedKeys.hasOnly(['status', 'finalReply', 'updatedAt'])
            && before.assignedTo == request.auth.uid
            && before.status == 'in_progress'
            && after.status == 'responded'
            && after.finalReply is string
            && after.finalReply.size() > 0
            && after.finalReply.size() <= 5000
          )
          // "Đóng khiếu nại": responded -> closed, không đổi field nào khác.
          // Cũng chỉ nhân viên đang xử lý ticket mới được đóng.
          || (
            changedKeys.hasOnly(['status', 'updatedAt'])
            && before.assignedTo == request.auth.uid
            && before.status == 'responded'
            && after.status == 'closed'
          )
        );
    }

    match /tickets/{ticketId} {
      allow read: if isStaff();
      allow create: if isValidNewTicket();
      allow update: if isValidStaffTicketUpdate();
      allow delete: if false;

      match /history/{entryId} {
        allow read: if isStaff();

        // Khách gửi khiếu nại lần đầu (không đăng nhập) cần ghi được đúng
        // 1 dòng lịch sử "created" kèm ticket vừa tạo; mọi bước tiếp theo
        // (claimed/responded/closed/ai_analyzed) do nhân viên đã đăng nhập
        // hoặc Cloud Functions (Admin SDK) ghi.
        // Dòng "created" chỉ ghi được trong cùng transaction tạo ticket:
        // ticket chưa tồn tại trước request nhưng tồn tại sau request, và
        // ticketCode phải trùng mã của ticket đó — chặn việc chèn thêm dòng
        // "created" giả vào lịch sử của ticket đã có.
        allow create: if isStaff()
          || (
            request.resource.data.keys().hasOnly(['ticketId', 'ticketCode', 'action', 'actorName', 'createdAt'])
            && request.resource.data.ticketId == ticketId
            && request.resource.data.action == 'created'
            && request.resource.data.actorName is string
            && request.resource.data.createdAt == request.time
            && !exists(/databases/$(database)/documents/tickets/$(ticketId))
            && existsAfter(/databases/$(database)/documents/tickets/$(ticketId))
            && request.resource.data.ticketCode
              == getAfter(/databases/$(database)/documents/tickets/$(ticketId)).data.code
          );
        allow update, delete: if false;
      }
    }

    // Bộ đếm sinh mã ticket tuần tự (TK01, TK02, ...) — chỉ cho phép tăng
    // đúng 1 đơn vị mỗi lần, không cho ghi giá trị tùy ý. Cho "get" vì
    // transaction tạo ticket (useComplaintForm.ts) phải đọc được giá trị
    // hiện tại trước khi tăng — giá trị này không có gì nhạy cảm (chỉ là
    // số thứ tự); chặn "list" vì không có lý do gì để liệt kê collection này.
    match /counters/tickets {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // Kết quả phân tích AI chỉ do Cloud Function analyzeTicketWithAI (Admin
    // SDK) ghi — Admin SDK bỏ qua rules nên "write: if false" không chặn nó,
    // chỉ chặn client (website/mobile) tự ý ghi/sửa kết quả AI.
    match /ai_results/{resultId} {
      allow read: if isStaff();
      allow write: if false;
    }
  }
}
