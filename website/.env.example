# Copy file này thành .env rồi điền giá trị thật từ Firebase Console
# (Project settings > General > Your apps > SDK setup and configuration).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Lưu ý: website/src/firebase.ts tự nối Emulator khi `import.meta.env.DEV`
# (tức khi chạy `npm run dev`). Khi build production (`npm run build`) Vite
# tự đặt DEV=false nên sẽ dùng thẳng Firebase project thật ở trên, không
# cần thêm biến bật/tắt riêng.
